{
	"name": "come-hang",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "firebase emulators:exec --only firestore --project demo-come-hang \"playwright test --config tests/playwright.config.ts\"",
		"test:accessibility": "playwright test --config tests/playwright.config.ts --project \"accessibility-*\"",
		"test:interaction": "playwright test --config tests/playwright.config.ts --project \"interaction-*\"",
		"test:rules": "firebase emulators:exec --only firestore --project demo-come-hang \"playwright test --config tests/playwright.config.ts --project rules\"",
		"test:security": "playwright test --config tests/playwright.config.ts --project \"security-*\"",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"firebase": "12.19.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@firebase/rules-unit-testing": "5.0.2",
		"@playwright/test": "^1.64.0",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"firebase-tools": "15.32.1",
		"jiti": "^2.7.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4"
	},
	"overrides": {
		"@firebase/firestore": {
			"@grpc/grpc-js": "1.14.6"
		},
		"playwright-core": "1.64.0"
	}
}
