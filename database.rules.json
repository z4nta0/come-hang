{
	"rules": {
		"chats": {
			"$conversationId": {
				"messages": {
					"$messageId": {
						"$other": {
							".validate": false
						},
						".validate": "newData.hasChildren(['ciphertext', 'iv', 'senderUid', 'sentAt'])",
						".write": "(!data.exists() && newData.exists() && auth != null && root.child('mirrors').child($conversationId).child('members').child(auth.uid).exists() && newData.child('senderUid').val() === auth.uid && newData.child('sentAt').val() === now) || (data.exists() && !newData.exists() && auth != null && root.child('mirrors').child($conversationId).child('members').child(auth.uid).exists() && (!data.child('waitingOn').exists() || data.child('sentAt').val() + root.child('mirrors').child($conversationId).child('chatTtlDays').val() * 86400000 < now))",
						"ciphertext": {
							".validate": "newData.isString() && newData.val().length >= 24 && newData.val().length <= 8024 && newData.val().matches(/^[A-Za-z0-9+\\/]+={0,2}$/)"
						},
						"iv": {
							".validate": "newData.isString() && newData.val().length === 16 && newData.val().matches(/^[A-Za-z0-9+\\/]+$/)"
						},
						"senderUid": {
							".validate": "newData.isString()"
						},
						"sentAt": {
							".validate": "newData.isNumber()"
						},
						"waitingOn": {
							"$uid": {
								".validate": "newData.val() === true && root.child('mirrors').child($conversationId).child('members').child($uid).exists()",
								".write": "data.exists() && !newData.exists() && (auth.uid === $uid || (auth != null && root.child('mirrors').child($conversationId).child('members').child(auth.uid).exists() && !root.child('mirrors').child($conversationId).child('members').child($uid).exists()))"
							}
						}
					},
					".indexOn": "sentAt",
					".read": "auth != null && query.orderByChild === 'sentAt' && query.startAt === root.child('mirrors').child($conversationId).child('members').child(auth.uid).val()"
				}
			}
		},
		"presence": {
			"$groupId": {
				"$uid": {
					"$other": {
						".validate": false
					},
					".validate": "newData.hasChildren(['online'])",
					".write": "auth != null && auth.uid === $uid && root.child('mirrors').child($groupId).child('members').child(auth.uid).exists()",
					"online": {
						".validate": "newData.isBoolean()"
					}
				},
				".read": "auth != null && root.child('mirrors').child($groupId).child('members').child(auth.uid).exists()"
			}
		}
	}
}
