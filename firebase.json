{
	"database": {
		"rules": "database.rules.json"
	},
	"emulators": {
		"auth": {
			"port": 8240
		},
		"database": {
			"port": 8210
		},
		"firestore": {
			"port": 8200
		},
		"functions": {
			"port": 8230
		},
		"singleProjectMode": true,
		"storage": {
			"port": 8220
		},
		"ui": {
			"enabled": false
		}
	},
	"firestore": {
		"indexes": "firestore.indexes.json",
		"rules": "firestore.rules"
	},
	"functions": {
		"predeploy": [
			"npm --prefix \"$RESOURCE_DIR\" run build"
		],
		"source": "functions"
	},
	"storage": {
		"rules": "storage.rules"
	}
}
